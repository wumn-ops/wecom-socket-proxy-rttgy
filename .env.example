# wecom-socket-proxy-rttgy — 独立实例，与 wecom-socket-proxy 并行部署
# 须使用独立 BotID/Secret、独立端口、独立 PUBLIC_BASE_URL

# 企业微信智能机器人 — 长连接模式（BotID + Secret）
WECOM_BOT_ID=
WECOM_BOT_SECRET=

HOST=0.0.0.0
PORT=8001
WECOM_CALLBACK_PATH=/wecom/aibot/callback/rttgy
HEALTH_PATH=/health/rttgy
LOG_LEVEL=INFO

# H5 上传 token 签名（默认使用 WECOM_BOT_SECRET）
# UPLOAD_TOKEN_SECRET=

# 智能表格「接收外部数据」Webhook（101239）
SMARTSHEET_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/wedoc/smartsheet/webhook?key=YOUR_KEY
SMARTSHEET_FIELD_DEMAND_CONTENT=f9VtuW
SMARTSHEET_FIELD_IMAGE=fhZuXt
SMARTSHEET_FIELD_SUBMITTER=f04Gwj
SMARTSHEET_FIELD_SYSTEM=fJodHY

# 登记卡片「所属系统」下拉选项（英文逗号分隔，后期可增删）
REGISTRATION_SYSTEM_OPTIONS=CRM,SAP,MES,其他

# 智能表格读接口（get_records，101167）— 上线测试提醒
SMARTSHEET_DOCID=
SMARTSHEET_SHEET_ID=
SMARTSHEET_FIELD_PROGRESS=ftQMc5
SMARTSHEET_FIELD_TEST_RESULT=ft3nIs
SMARTSHEET_FIELD_SATISFACTION=fLOs6M
LAUNCH_PROGRESS_VALUE=已上线
LAUNCH_TEST_PASS_VALUE=通过
FEEDBACK_TEST_FAIL_VALUE=不通过
LAUNCH_NOTIFY_ENABLED=true
LAUNCH_POLL_INTERVAL_SECONDS=60
LAUNCH_NOTIFY_STATE_PATH=data/launch_notified.json

# H5 上传页 / 评价页公网地址（与 Nginx 外网域名一致，路径带 /rttgy 后缀）
PUBLIC_BASE_URL=https://wecom.vazyme.com:8021
REGISTER_UPLOAD_PATH=/register/upload/rttgy
FEEDBACK_PATH=/feedback/rttgy
UPLOAD_TOKEN_TTL_SECONDS=3600
FEEDBACK_TOKEN_TTL_SECONDS=604800
MAX_UPLOAD_BYTES=5242880

# 登记卡片「打开问题清单」链接
ISSUE_LIST_URL=

# 可选：H5 关闭窗口 + 智能表格读接口（须配置可信域名与文档权限）
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_CORP_SECRET=
